# --- AETHERVOICE CORE CONFIG ---
APP_NAME=AetherVoice
APP_URL=http://localhost:3000

# --- KIRAPAY (Cross-Chain Execution) ---
# Get your API Key from https://dashboard.kira-pay.com/
KIRAPAY_API_KEY=your_kira_api_key_here
KIRAPAY_ENVIRONMENT=testnet
# The Solana wallet address where the Indian SME receives USDC
MERCHANT_SOLANA_WALLET=your_solana_wallet_address

# --- TETHER QVAC (Sovereign Intelligence) ---
# Local model path for quantized Llama/OCR (Standard QVAC setup)
QVAC_MODEL_PATH=./models/qvac-v1-quantized.onnx
QVAC_TRUST_THRESHOLD=90

# --- SOLANA INFRASTRUCTURE ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
